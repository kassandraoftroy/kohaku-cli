{
    "name": "kohaku-cli",
    "version": "0.0.2",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "bin": {
        "kohaku": "./bin/kohaku.mjs"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "dev": "tsx src/index.ts",
        "dev:prod": "NODE_ENV=production tsx src/index.ts",
        "start": "node ./bin/kohaku.mjs"
    },
    "dependencies": {
        "@1001-digital/ethereum-names": "0.3.0",
        "@clack/prompts": "0.7.0",
        "@inquirer/prompts": "8.3.2",
        "@kohaku-eth/plugins": "0.0.1-alpha.11",
        "@kohaku-eth/privacy-pools": "0.0.2-alpha.14",
        "@kohaku-eth/railgun": "0.0.1-alpha.28",
        "@kohaku-eth/tornado-cash": "0.0.2-alpha.19",
        "chalk": "5.6.2",
        "commander": "14.0.3",
        "derive-railgun-keys": "0.1.0",
        "eth-prices": "1.1.0",
        "ox": "0.12.0",
        "tor-js": "0.4.0",
        "viem": "2.52.2"
    },
    "devDependencies": {
        "@types/node": "22.19.15",
        "tsup": "8.5.1",
        "tsx": "4.0.0",
        "typescript": "5.9.2"
    }
}
